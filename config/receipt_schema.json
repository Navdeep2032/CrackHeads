{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SplitSnap Receipt Extraction Schema",
  "type": "object",
  "required": ["items", "charges", "subtotal", "grand_total"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "qty", "unit_price", "total"],
        "properties": {
          "name": {"type": "string"},
          "qty": {"type": ["number", "integer"]},
          "unit_price": {"type": "number"},
          "total": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "amount"],
        "properties": {
          "type": {"type": "string"},
          "amount": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "subtotal": {"type": "number"},
    "grand_total": {"type": "number"}
  },
  "additionalProperties": true
}
